# ═══════════════════════════════════════════════════════════════
#   DevSecOps Pipeline — Environment Configuration Template
#   Copy this file: cp .env.example .env
#   Then fill in your values
#   NEVER commit .env to GitHub — it is in .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Network ─────────────────────────────────────────────────────
VM_IP=192.168.56.101
HOST_ONLY_INTERFACE=enp0s8

# ── Ports ───────────────────────────────────────────────────────
SSH_PORT=2277
JENKINS_PORT=8080
SONARQUBE_PORT=9000
DEFECTDOJO_PORT=8090
GRAFANA_PORT=3000
DVWA_PORT=8888

# ── Credentials — CHANGE ALL OF THESE ───────────────────────────
JENKINS_ADMIN_PASSWORD=ChangeMe@Jenkins1
SONARQUBE_ADMIN_PASSWORD=ChangeMe@Sonar1
DEFECTDOJO_ADMIN_PASSWORD=ChangeMe@Dojo1!
GRAFANA_ADMIN_PASSWORD=ChangeMe@Grafana1

# ── GitHub ──────────────────────────────────────────────────────
GITHUB_USERNAME=your_github_username
GITHUB_REPO=https://github.com/your_username/DVWA
GITHUB_PAT=ghp_your_personal_access_token_here

# ── SonarQube (filled after first login) ────────────────────────
SONARQUBE_TOKEN=squ_your_token_here
SONARQUBE_PROJECT_KEY=DVWA
SONARQUBE_PROJECT_NAME=DVWA

# ── DefectDojo (filled after first login) ───────────────────────
DEFECTDOJO_API_KEY=your_defectdojo_api_key_here
DEFECTDOJO_ENGAGEMENT_ID=1
DEFECTDOJO_PRODUCT_NAME=DVWA

# ── Tool Versions ────────────────────────────────────────────────
DOCKER_COMPOSE_VERSION=v2.24.0
DEPENDENCY_CHECK_VERSION=9.0.9

# ── System ──────────────────────────────────────────────────────
DEPLOY_USER=devops
